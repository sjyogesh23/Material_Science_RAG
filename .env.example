# ---------- Paths ----------
DATA_DIR=data
OUTPUT_DIR=extracted

# ---------- Hardware ----------
# auto | cuda | cpu
DEVICE=auto
NUM_THREADS=4

# ---------- Docling conversion ----------
# Pages converted per Docling call (keeps RAM bounded on 500+ page textbooks)
PAGE_BATCH_SIZE=10
# Page render scale for crops (2.0 = 144 dpi)
IMAGES_SCALE=2.0
# OCR for scanned pages / bitmap text
ENABLE_OCR=true
# Force OCR on every page (slow; only for fully scanned corpora)
FORCE_FULL_PAGE_OCR=false
# Formula -> LaTeX (Docling CodeFormulaV2)
ENABLE_FORMULA_LATEX=true
# Code block language detection
ENABLE_CODE_ENRICHMENT=true
# Figure type classification (bar_chart, flow_chart, chemistry_structure, ...)
ENABLE_PICTURE_CLASSIFICATION=true
# Save a crop PNG for every formula (useful for re-checking LaTeX)
SAVE_FORMULA_IMAGES=true
# Save a crop PNG for every table
SAVE_TABLE_IMAGES=true

# ---------- Image understanding ----------
# Natural-language descriptions with a vision-language model
ENABLE_PICTURE_DESCRIPTION=true
# OCR of text inside images (scale bars, labels, plates, axis ticks ...)
ENABLE_IMAGE_OCR=true
# Skip VLM for images smaller than this fraction of the page (icons, bullets)
MIN_IMAGE_AREA_FRACTION=0.01

# local  -> HuggingFace model run in-process
# api    -> any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, ...)
VLM_BACKEND=local
# Qwen/Qwen3.5-0.8B  ~1.8 GB VRAM fp16, ~9 s/figure on RTX 3050  (default)
# Qwen/Qwen3.5-2B    better quality; set VLM_LOAD_4BIT=true on 4 GB GPUs (slower)
# Qwen/Qwen3.5-4B    best local quality; needs VLM_LOAD_4BIT=true on 4 GB GPUs
VLM_LOCAL_MODEL=Qwen/Qwen3.5-0.8B
VLM_LOAD_4BIT=false
VLM_MAX_IMAGE_SIDE=896
VLM_MAX_NEW_TOKENS=400

# For VLM_BACKEND=api (example: Ollama)
VLM_API_URL=http://localhost:11434/v1/chat/completions
VLM_API_MODEL=qwen3.5:4b
VLM_API_KEY=
VLM_TIMEOUT=180

# ---------- Hugging Face ----------
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_HOME=E:/hf_cache

# ---------- Chunking / embeddings ----------
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40
EMBED_BATCH_SIZE=8

# ---------- Retrieval backends (measured 2026-10-18, see app/retrieval/*.py docstrings) ----------
# ollama = models served by the Ollama server (no torch in the API process, ~0.6 GB RSS instead of ~6 GB)
# sentence_transformers = in-process torch models EMBED_MODEL / RERANK_MODEL (EMBED_DEVICE / RERANK_DEVICE)
# Switching EMBED_BACKEND requires `python -m app.ingest` (chunks are re-embedded automatically).
EMBED_BACKEND=ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# 0 = CPU (~0.1 s/query, keeps the GPU for the chat LLM); -1 = let Ollama decide
OLLAMA_EMBED_NUM_GPU=0
OLLAMA_EMBED_NUM_CTX=2048
RERANK_BACKEND=ollama
# built locally by: .venv/Scripts/python scripts/build_reranker_gguf.py
OLLAMA_RERANK_MODEL=qwen3-reranker:0.6b-q8_0
# -1 = let Ollama decide (fits on the GPU next to qwen3:4b: ~45 ms/pair); 0 = CPU (~1 s/pair)
OLLAMA_RERANK_NUM_GPU=-1
OLLAMA_RERANK_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=2h
# sentence_transformers reranker on CPU: none | int8
RERANK_QUANTIZE=none

# ---------- App (app/config.py) - retrieval / database ----------
# DATABASE_URL=                 # empty -> embedded Postgres (pgserver) in PG_DATA_DIR
PG_DATA_DIR=pgdata
# cpu | cuda | auto  (auto = cuda only if AUTO_MIN_FREE_VRAM_GB is free when the model loads)
EMBED_DEVICE=cpu
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_DEVICE=cpu
AUTO_MIN_FREE_VRAM_GB=2.0
# float32 (fast) | bfloat16 (half the RAM, ~5x slower on CPU)
CPU_DTYPE=float32
# ingest embedding device: auto = cuda if >= INGEST_MIN_FREE_VRAM_GB free, else cpu
INGEST_DEVICE=auto
INGEST_MIN_FREE_VRAM_GB=2.5
TOP_K_DENSE=40
TOP_K_BM25=40
RRF_K=60
# candidates reranked: RERANK_TOP_N when the reranker is on the GPU (~45 ms each),
# RERANK_TOP_N_CPU when it runs on CPU (~1 s each)
RERANK_TOP_N=20
RERANK_TOP_N_CPU=5
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=4
FINAL_K=6
OOC_THRESHOLD=0.25
OOC_SOFT_THRESHOLD=0.50
GROUNDING_CHECK=false
FIGURE_MIN_SCORE=0.10

# ---------- Misc (read directly via os.getenv) ----------
# Ollama server used by the chat LLM client
# OLLAMA_HOST_URL=http://127.0.0.1:11434
# Skip model warmup when the API starts (any non-empty value)
# NEWRAG_SKIP_WARMUP=
# Per-turn timeout for eval/run.py, in seconds
# EVAL_TURN_TIMEOUT_S=420
